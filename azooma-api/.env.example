# ==============================================================================
# Azooma API — Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to Git.
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development

# ==============================================================================
# Supabase PostgreSQL (Direct Connection via Prisma)
# Find this in: Supabase Dashboard → Settings → Database → Connection String
# Use the "URI" tab and select "Transaction" pooler for serverless, or
# "Direct connection" for a long-running server.
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# ==============================================================================
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ==============================================================================
# Firebase Admin SDK
# Generate from: Firebase Console → Project Settings → Service Accounts
#                → Generate New Private Key (downloads a JSON file)
# Then paste the individual values below:
# ==============================================================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# IMPORTANT: Replace literal \n with actual newlines, OR keep as-is and the
# config/firebase.ts will handle the escape sequences automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# API Security
# ==============================================================================
# A secret used internally for admin-to-admin calls (optional but recommended)
API_SECRET="change-this-to-a-long-random-secret"
